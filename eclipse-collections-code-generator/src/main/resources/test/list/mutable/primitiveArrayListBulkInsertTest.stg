import "copyrightOf.stg"
import "primitiveLiteral.stg"

isTest() ::= "true"
skipBoolean() ::= "true"
targetPath() ::= "com/m3/collections/eclipse/impl/list/mutable/primitive"
fileName(primitive) ::= "<primitive.name>ArrayListBulkInsertTest"
class(primitive) ::= <<
<body(primitive, primitive.type, primitive.name, primitive.wrapperName)>
>>

body(primitive, type, name, wrapperName) ::= <<
<copyrightOf("Hitesh Soliwal and Contributors to the Synexia Project")>

package com.m3.collections.eclipse.impl.list.mutable.primitive;

import java.io.ByteArrayInputStream;
import java.io.ByteArrayOutputStream;
import java.io.ObjectInputStream;
import java.io.ObjectOutputStream;
import java.lang.reflect.Proxy;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.Random;

import com.m3.collections.eclipse.api.<name>Iterable;
import org.junit.jupiter.api.Test;

import static org.junit.jupiter.api.Assertions.assertArrayEquals;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

/** Original array-list insertion contract checks generated for each primitive family. */
public class <name>ArrayListBulkInsertTest
{
    private static <type>[] values(int count, int first)
    {
        <type>[] result = new <type>[count];
        for (int i = 0; i \< count; i++)
        {
            result[i] = (<type>) (first + i);
        }
        return result;
    }

    private static <type>[] expected(<type>[] before, int index, <type>[] added)
    {
        List\<<wrapperName>\> model = new ArrayList\<>();
        for (<type> value : before)
        {
            model.add(value);
        }
        for (int i = 0; i \< added.length; i++)
        {
            model.add(index + i, added[i]);
        }
        <type>[] result = new <type>[model.size()];
        for (int i = 0; i \< result.length; i++)
        {
            result[i] = model.get(i);
        }
        return result;
    }

    @Test
    public void independentSourcesAtEverySmallInsertionPoint()
    {
        for (int count = 0; count \< 13; count++)
        {
            for (int added = 0; added \< 13; added++)
            {
                for (int index = 0; index \<= count; index++)
                {
                    for (int spare : new int[]{0, 32})
                    {
                        <type>[] before = values(count, 10);
                        <type>[] incoming = values(added, 50);
                        <name>ArrayList target = new <name>ArrayList(count + spare);
                        target.addAll(before);
                        <name>ArrayList source = <name>ArrayList.wrapCopy(incoming);
                        assertEquals(added != 0, target.addAllAtIndex(index, (<name>Iterable) source));
                        assertArrayEquals(expected(before, index, incoming), target.toArray());
                        assertArrayEquals(incoming, source.toArray());
                    }
                }
            }
        }
    }

    @Test
    public void selfInsertionKeepsTheOriginalSnapshot()
    {
        for (int size = 0; size \< 13; size++)
        {
            for (int index = 0; index \<= size; index++)
            {
                for (int spare : new int[]{0, 32})
                {
                    <type>[] before = values(size, 1);
                    <name>ArrayList target = new <name>ArrayList(size + spare);
                    target.addAll(before);
                    assertEquals(size != 0, target.addAllAtIndex(index, (<name>Iterable) target));
                    assertArrayEquals(expected(before, index, before), target.toArray());
                }
            }
        }
    }

    @Test
    public void distinctListsSharingSpareBackingStorageKeepSnapshotOrder()
    {
        <type>[] shared = values(16, 1);
        <name>ArrayList target = new <name>ArrayList(shared);
        <name>ArrayList source = new <name>ArrayList(shared);
        while (target.size() > 2)
        {
            target.removeAtIndex(target.size() - 1);
        }
        while (source.size() > 2)
        {
            source.removeAtIndex(source.size() - 1);
        }
        <type>[] before = target.toArray();
        <type>[] incoming = source.toArray();
        <type>[] result = expected(before, 1, incoming);
        assertTrue(target.addAllAtIndex(1, (<name>Iterable) source));
        assertArrayEquals(result, target.toArray());
        assertArrayEquals(Arrays.copyOf(result, 2), source.toArray());
    }

    @Test
    public void sourceExportOverrideRunsBeforeDestinationArrayOverride()
    {
        List\<String> calls = new ArrayList\<>();
        <name>ArrayList source = new <name>ArrayList()
        {
            @Override
            public <type>[] toArray()
            {
                calls.add("source export");
                return values(2, 50);
            }
        };
        <name>ArrayList target = new <name>ArrayList()
        {
            @Override
            public boolean addAllAtIndex(int index, <type>... incoming)
            {
                calls.add("destination array overload");
                assertArrayEquals(values(2, 50), incoming);
                return false;
            }
        };
        assertFalse(target.addAllAtIndex(-1, (<name>Iterable) source));
        assertEquals(Arrays.asList("source export", "destination array overload"), calls);
    }

    @Test
    public void sourceSubclassExportIsHonoredByOrdinaryDestination()
    {
        int[] calls = {0};
        <name>ArrayList source = new <name>ArrayList()
        {
            @Override
            public <type>[] toArray()
            {
                calls[0]++;
                return values(3, 60);
            }
        };
        <name>ArrayList target = <name>ArrayList.newListWith(values(4, 10));
        assertTrue(target.addAllAtIndex(2, (<name>Iterable) source));
        assertArrayEquals(expected(values(4, 10), 2, values(3, 60)), target.toArray());
        assertEquals(1, calls[0]);
    }

    @Test
    public void externalIterableKeepsItsExportDemand()
    {
        List\<String> calls = new ArrayList\<>();
        <name>Iterable source = (<name>Iterable) Proxy.newProxyInstance(
                <name>Iterable.class.getClassLoader(), new Class\<?>[]{<name>Iterable.class},
                (proxy, method, arguments) ->
                {
                    calls.add(method.getName());
                    if (!method.getName().equals("toArray") || arguments != null)
                    {
                        throw new AssertionError("Unexpected callback: " + method);
                    }
                    return values(3, 40);
                });
        <name>ArrayList target = <name>ArrayList.newListWith(values(2, 10));
        assertTrue(target.addAllAtIndex(1, source));
        assertEquals(Arrays.asList("toArray"), calls);
        assertArrayEquals(expected(values(2, 10), 1, values(3, 40)), target.toArray());
    }

    @Test
    public void exportFailurePrecedesIndexValidation()
    {
        IllegalStateException marker = new IllegalStateException("source failure");
        <name>ArrayList source = new <name>ArrayList()
        {
            @Override
            public <type>[] toArray()
            {
                throw marker;
            }
        };
        <name>ArrayList target = new <name>ArrayList();
        assertEquals(marker, assertThrows(IllegalStateException.class,
                () -> target.addAllAtIndex(-1, (<name>Iterable) source)));
        assertThrows(NullPointerException.class, () -> target.addAllAtIndex(-1, (<name>Iterable) null));
        assertThrows(IndexOutOfBoundsException.class, () -> target.addAllAtIndex(-1, new <name>ArrayList()));
        assertThrows(IndexOutOfBoundsException.class, () -> target.addAllAtIndex(1, new <name>ArrayList()));
        assertArrayEquals(new <type>[0], target.toArray());
    }

    @Test
    public void seededMutationSequenceKeepsLogicalListOrder()
    {
        Random random = new Random(0x3ec011ec7L);
        <name>ArrayList target = new <name>ArrayList(300);
        List\<<wrapperName>\> model = new ArrayList\<>();
        for (int step = 0; step \< 1500; step++)
        {
            int index = random.nextInt(model.size() + 1);
            <type>[] incoming = values(random.nextInt(16), random.nextInt(90));
            <name>ArrayList source = <name>ArrayList.wrapCopy(incoming);
            assertEquals(incoming.length != 0, target.addAllAtIndex(index, (<name>Iterable) source));
            for (int i = 0; i \< incoming.length; i++)
            {
                model.add(index + i, incoming[i]);
            }
            while (model.size() > 150)
            {
                int removed = random.nextInt(model.size());
                assertEquals(model.remove(removed), <wrapperName>.valueOf(target.removeAtIndex(removed)));
            }
            assertEquals(model.size(), target.size());
            for (int i = 0; i \< model.size(); i++)
            {
                assertEquals(model.get(i), <wrapperName>.valueOf(target.get(i)));
            }
            assertArrayEquals(incoming, source.toArray());
        }
    }

    @Test
    public void insertedContentsSurviveSerialization() throws Exception
    {
        <name>ArrayList target = <name>ArrayList.newListWith(values(7, 10));
        target.addAllAtIndex(3, (<name>Iterable) <name>ArrayList.newListWith(values(9, 40)));
        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
        try (ObjectOutputStream output = new ObjectOutputStream(bytes))
        {
            output.writeObject(target);
        }
        try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray())))
        {
            <name>ArrayList restored = (<name>ArrayList) input.readObject();
            assertArrayEquals(target.toArray(), restored.toArray());
            restored.addAllAtIndex(0, (<name>Iterable) target);
            assertArrayEquals(expected(target.toArray(), 0, target.toArray()), restored.toArray());
        }
    }
<if(primitive.floatPrimitive)>
    @Test
    public void floatingPointPayloadBitsAreCopiedUnchanged()
    {
        float[] incoming = {Float.intBitsToFloat(0x7fc12345), -0.0f, Float.POSITIVE_INFINITY, Float.MIN_VALUE};
        FloatArrayList target = FloatArrayList.newListWith(1.0f, 2.0f);
        target.addAllAtIndex(1, (FloatIterable) FloatArrayList.wrapCopy(incoming));
        for (int i = 0; i \< incoming.length; i++)
        {
            assertEquals(Float.floatToRawIntBits(incoming[i]), Float.floatToRawIntBits(target.get(i + 1)));
        }
    }
<endif>
<if(primitive.doublePrimitive)>
    @Test
    public void floatingPointPayloadBitsAreCopiedUnchanged()
    {
        double[] incoming = {Double.longBitsToDouble(0x7ff8123456789abcL), -0.0, Double.NEGATIVE_INFINITY, Double.MIN_VALUE};
        DoubleArrayList target = DoubleArrayList.newListWith(1.0, 2.0);
        target.addAllAtIndex(1, (DoubleIterable) DoubleArrayList.wrapCopy(incoming));
        for (int i = 0; i \< incoming.length; i++)
        {
            assertEquals(Double.doubleToRawLongBits(incoming[i]), Double.doubleToRawLongBits(target.get(i + 1)));
        }
    }
<endif>
}
>>
